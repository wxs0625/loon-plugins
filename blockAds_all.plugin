#!name=广告拦截&净化合集(整合版)
#!desc=基于奶思 blockAds.plugin 整合 38 个独立 sgmodule 去广告/功能增强模块，一个插件搞定全部。参数开关可在插件配置中单独控制。
#!author=奶思, RuCu6, 可莉, VirgilClyne 等[https://github.com/fmz200]
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/AdblockPlus.png
#!homepage=https://github.com/wxs0625/loon-plugins
#!raw-url=https://raw.githubusercontent.com/wxs0625/loon-plugins/main/blockAds_all.plugin
#!category=去广告
#!tag=去广告, 广告拦截, 净化
#!system=iOS, iPadOS
#!loon_version=3.4.0
#!date=2026-08-17 15:29:50
#!remark=本插件整合自 blockAds.plugin 与 38 个 sgmodule 模块。各模块的参数开关已统一加入 [Argument] 段，默认值参照原模块。Map Local 段已转换为 URL Rewrite reject。
#############################################
# 整合内容：
# 1. 原始 blockAds.plugin 的全部规则/脚本
# 2. 以下 38 个独立模块（按字母序）：
#   广告平台拦截器, HTTPDNS拦截器, 可莉广告过滤器
#   京东/淘宝/闲鱼/转转去广告, 网易云音乐/QQ音乐/酷狗/汽水音乐去广告
#   知乎/小红书/酷安/米游社/小黑盒去广告
#   爱奇艺/优酷/腾讯视频/555电影去广告
#   番茄/书旗/纵横小说去广告, 阿里云盘/菜鸟去广告
#   微信小程序/公众号/外部链接, 12306/高德/美图秀秀去广告
#   网易邮箱大师/腾讯文档/金山文档去广告
#   1.1.1.1配置管理, Apple天气增强, YouTubeNoAds
#############################################
# 段说明：
# [Argument]  - 各模块参数开关
# [Rule]      - DOMAIN/URL-REGEX REJECT 规则
# [Rewrite]   - URL Rewrite + Body Rewrite 合并
# [Script]    - http-request/response 脚本
# [MITM]      - hostname 列表
#############################################

[Argument]
# === 原始 blockAds.plugin 参数 ===
12306_enable = switch,true,false,tag=12306-脚本开关
555_enable = switch,true,false,tag=555影视-脚本开关
